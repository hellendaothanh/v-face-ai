# Server Configuration
PROJECT_NAME="V-Face Attendance API"
API_V1_STR="/api/v1"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# PostgreSQL + pgvector Configuration
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vface_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# Face Recognition Settings (Static API)
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_PROVIDERS=["CoreMLExecutionProvider", "CPUExecutionProvider"]
FACE_SIMILARITY_THRESHOLD=0.60
FACE_DETECTION_MIN_SCORE=0.75
MAX_IMAGE_SIZE_MB=10

# ==============================================================================
# Dual Camera Source Configuration
# Option 1: WEBCAM (Camera tích hợp trên MacBook Air M4)
# Option 2: RTSP (Camera IP Tapo C200)
# ==============================================================================
CAMERA_DEFAULT_SOURCE=WEBCAM

# 1. MacBook Air M4 Built-in Camera
WEBCAM_INDEX=0
WEBCAM_DEVICE_ID="MACBOOK_M4_WEBCAM"

# 2. Tapo C200 RTSP Stream
# Example Tapo RTSP: rtsp://<tapo_username>:<tapo_password>@192.168.1.100:554/stream1
# Lưu ý: Nếu mật khẩu có ký tự đặc biệt như @ -> %40, # -> %23, ! -> %21
RTSP_URL="rtsp://admin:admin123@192.168.1.100:554/stream1"
RTSP_DEVICE_ID="TAPO_C200_GATE"

# Realtime AI Pipeline Settings
CAMERA_FRAME_SKIP=5
CAMERA_MIN_FACE_SIZE=80
# Bộ lọc độ nhòe ảnh chuyển động (Laplacian Variance):
# Khuyến nghị: 50.0 - 80.0 (Dưới ngưỡng này sẽ bỏ qua không trích xuất vector)
CAMERA_BLUR_THRESHOLD=60.0

# Ngưỡng tương đồng Cosine (Cosine Similarity Threshold):
# - Webcam máy tính (ảnh nét, đủ sáng): 0.60 - 0.70 (60% - 70%)
# - Camera Tapo C200 RTSP (video nén, góc nghiêng): 0.55 - 0.60 (55% - 60%)
CAMERA_SIMILARITY_THRESHOLD=0.58
CAMERA_COOLDOWN_SECONDS=300
CAMERA_AUTO_START=false

# Storage
UPLOAD_DIR="./uploads"
